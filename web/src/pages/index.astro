---
import Base from '../layouts/Base.astro';
import CourseArt from '../components/CourseArt.astro';
import { COURSES, fmaTopics, fmaQuestionCount, usaboQuestionCount } from '../lib/courses';
import { loadPapers, paperTitle } from '../lib/papers';

const topics = fmaTopics();
const exams = loadPapers()
  .filter((p) => p.paper.competition_id === 'fma')
  .map((p) => ({ id: p.id, title: paperTitle(p), limit: p.paper.time_limit_minutes * 60 }));
const allIds = [...new Set(topics.flatMap((t) => t.questions.map((q) => q.id)))];
const clientData = JSON.stringify({
  topics: topics.map((t) => ({ slug: t.slug, name: t.name, ids: t.questions.map((q) => q.id) })),
  exams,
  allIds,
});
---

<Base title="Olympiad Prep" current="home">
  <section class="welcome">
    <h1>Practice for the science olympiads</h1>
    <p class="lede">
      Real past questions from F=ma, USABO, and USNCO. Work through them by topic, or sit a full exam against the clock.
    </p>
  </section>

  <section class="resume panel" data-resume hidden>
    <div>
      <p class="resume-kicker muted" data-resume-kicker></p>
      <h2 data-resume-title></h2>
    </div>
    <a class="btn" data-resume-link href="/">Continue</a>
  </section>

  <section class="section">
    <h2>Courses</h2>
    <div class="cards">
      <a class="panel course-card" href="/course/fma/" style={`--c:${COURSES.fma.color}`}>
        <div class="art"><CourseArt kind="physics" /></div>
        <div class="body">
          <span class="kind">{COURSES.fma.discipline}</span>
          <h3>{COURSES.fma.name}</h3>
          <p>{fmaQuestionCount()} questions in {topics.length} topics, and {exams.length} full exams you can sit timed.</p>
          <div class="track" aria-hidden="true"><i data-course-bar></i></div>
          <p class="stat" data-course-stat>Not started</p>
        </div>
      </a>
      <a class="panel course-card" href="/course/usabo/" style={`--c:${COURSES.usabo.color}`}>
        <div class="art"><CourseArt kind="bio" /></div>
        <div class="body">
          <span class="kind">{COURSES.usabo.discipline}</span>
          <h3>{COURSES.usabo.name}</h3>
          <p>{usaboQuestionCount()} Open Exam questions sorted by topic, linked to the official exams, plus past cutoff scores.</p>
        </div>
      </a>
      <a class="panel course-card" href="/course/usnco/" style={`--c:${COURSES.usnco.color}`}>
        <div class="art"><CourseArt kind="chem" /></div>
        <div class="body">
          <span class="kind">{COURSES.usnco.discipline}</span>
          <h3>{COURSES.usnco.name}</h3>
          <p>Practice questions are not here yet. The course page links to the official ACS exams.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="section" data-weak hidden>
    <h2>Worth another look</h2>
    <p class="sub">Topics where you missed the most questions last time.</p>
    <div class="weak-list" data-weak-list></div>
  </section>

  <script type="application/json" id="home-data" set:html={clientData.replace(/</g, '\\u003c')} />
  <script>
    import { attemptFor, lastPractice, loadPractice, summarize } from '../scripts/progress';

    const data = JSON.parse(document.getElementById('home-data')!.textContent!);
    const progress = loadPractice();

    // F=ma card: how many questions have been answered correctly at least once most recently
    const done = summarize(progress, data.allIds);
    const answered = done.correct + done.missed;
    const bar = document.querySelector<HTMLElement>('[data-course-bar]')!;
    const stat = document.querySelector<HTMLElement>('[data-course-stat]')!;
    bar.style.width = `${(done.correct / data.allIds.length) * 100}%`;
    stat.textContent = answered === 0 ? 'Not started' : `${done.correct} of ${data.allIds.length} correct, ${answered} tried`;

    // Resume: an exam in progress beats the last practice topic
    const resume = document.querySelector<HTMLElement>('[data-resume]')!;
    const setResume = (kicker: string, title: string, href: string, label: string) => {
      (document.querySelector('[data-resume-kicker]') as HTMLElement).textContent = kicker;
      (document.querySelector('[data-resume-title]') as HTMLElement).textContent = title;
      const link = document.querySelector<HTMLAnchorElement>('[data-resume-link]')!;
      link.href = href;
      link.textContent = label;
      resume.hidden = false;
    };
    const running = data.exams
      .map((e: { id: string; title: string; limit: number }) => ({ e, a: attemptFor(e.id) }))
      .find(({ e, a }: any) => a && !a.submittedAt && a.startedAt + e.limit * 1000 > Date.now());
    if (running) {
      const left = Math.floor((running.a.startedAt + running.e.limit * 1000 - Date.now()) / 60000);
      setResume('Exam in progress', `${running.e.title}, about ${left} minutes left`, `/papers/${running.e.id}/`, 'Resume exam');
    } else {
      const last = lastPractice();
      if (last) setResume('Pick up where you left off', `${last.name} practice`, `/practice/${last.course}/${last.topic}/`, 'Continue practice');
    }

    // Weak spots: topics with at least one missed question, worst first
    const weak = data.topics
      .map((t: { slug: string; name: string; ids: string[] }) => ({ t, s: summarize(progress, t.ids) }))
      .filter(({ s }: any) => s.missed > 0)
      .sort((a: any, b: any) => b.s.missed - a.s.missed)
      .slice(0, 4);
    if (weak.length) {
      const list = document.querySelector<HTMLElement>('[data-weak-list]')!;
      list.innerHTML = weak
        .map(
          ({ t, s }: any) =>
            `<a class="weak panel" href="/practice/fma/${t.slug}/"><b>${t.name}</b><span class="muted">${s.missed} missed of ${s.correct + s.missed} tried</span></a>`,
        )
        .join('');
      document.querySelector<HTMLElement>('[data-weak]')!.hidden = false;
    }
  </script>
</Base>

<style>
  .welcome h1 {
    max-width: 18ch;
  }
  .lede {
    margin-top: 14px;
    font-size: var(--step-1);
    color: var(--muted);
    max-width: 52ch;
  }
  .resume {
    margin-top: 28px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-color: var(--accent);
  }
  .resume[hidden] {
    display: none;
  }
  .resume h2 {
    font-size: 1.3rem;
  }
  .resume-kicker {
    margin: 0 0 4px;
    font-size: 0.85rem;
  }
  .stat {
    font-size: 0.85rem !important;
  }
  @media (max-width: 600px) {
    .resume {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
