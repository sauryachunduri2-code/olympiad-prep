---
import Base from '../layouts/Base.astro';
import { loadPapers, loadCutoffs, loadUsaboLinks, paperTitle } from '../lib/papers';

const fma = loadPapers().filter((p) => p.paper.competition_id === 'fma');
const cut = loadCutoffs();
const links = loadUsaboLinks();
const years = [
  ...new Set([...Object.keys(cut.open.cutoffs), ...Object.keys(cut.semifinal.cutoffs)]),
].sort((a, b) => Number(b) - Number(a));
const notes = (y: string) =>
  [cut.open.notes[y], cut.semifinal.notes[y]].filter(Boolean).join(' ');
const official = (round: 'open' | 'semifinal', y: string) => links[round][y];
const label = { open: 'Open', semifinal: 'Semifinal' } as const;
---

<Base title="Official exams and cutoffs: Olympiad Prep" current="resources" crumbs={[{ label: 'Resources' }]} description="Official F=ma exams, USNCO and USABO resources, and past USABO cutoffs.">
  <div class="resources">
    <h1>Official exams and cutoffs</h1>
    <p class="lede">Official exams and score benchmarks, sorted by subject.</p>

    <section id="physics" class="subject">
      <div class="subject-head">
        <h2>Physics</h2>
        <p>F=ma is a 25-question, 75-minute multiple-choice exam from AAPT. These papers are tagged by topic and can be sat here.</p>
      </div>
      <div class="subject-body">
        <ul class="rows">
          {
            fma.map((p) => (
              <li>
                <div>
                  <h3>{paperTitle(p)}</h3>
                  <p class="meta">
                    {p.paper.question_count} questions, {p.paper.time_limit_minutes} minutes. Official{' '}
                    <a href={p.paper.source_url}>exam</a> and <a href={p.paper.solutions_url}>solutions</a> from AAPT.
                  </p>
                </div>
                <a class="btn" href={`/papers/${p.id}/`}>Sit this paper</a>
              </li>
            ))
          }
        </ul>
        <p class="more">
          AAPT lists every year back to 2008 on its <a href="https://aapt.org/physicsteam/PT-exams.cfm">exams page</a>.
          More years will be added here.
        </p>
      </div>
    </section>

    <section id="chemistry" class="subject">
      <div class="subject-head">
        <h2>Chemistry</h2>
        <p>USNCO is run by the American Chemical Society.</p>
      </div>
      <div class="subject-body">
        <p>
          USNCO papers are not on this site yet. The local exam is 60 multiple-choice questions in 110
          minutes, and the national exam adds written and lab parts. ACS posts past exams with answer keys on
          its <a href="https://www.acs.org/education/olympiad/prepare-for-exams.html">prepare-for-exams page</a>.
        </p>
      </div>
    </section>

    <section id="biology" class="subject">
      <div class="subject-head">
        <h2>Biology</h2>
        <p>USABO is run by the Center for Excellence in Education (CEE).</p>
      </div>
      <div class="subject-body">
        <p>
          CEE does not allow its exams to be stored or redistributed without permission, so no USABO
          questions are kept here. Instead, the table links to CEE's own copy of each exam and answer key
          and shows the score each year's cutoff landed on.
        </p>
        <p>
          <a class="btn quiet" href="/hub/usabo/">Find 2015 to 2018 Open Exam questions by topic</a>
        </p>
        <div class="scroll" tabindex="0" role="region" aria-label="USABO exams and cutoffs by year">
          <table>
            <caption>
              Official USABO exams and past cutoff scores. CEE's index stops at 2018. Semifinal scoring
              changed over the years, so read the notes before comparing one year with another.
            </caption>
            <thead>
              <tr>
                <th scope="col">Year</th>
                <th scope="col">Open exam</th>
                <th scope="col">Open cutoff</th>
                <th scope="col">Semifinal exam</th>
                <th scope="col">Semifinal cutoff</th>
                <th scope="col">Notes</th>
              </tr>
            </thead>
            <tbody>
              {
                years.map((y) => (
                  <tr>
                    <th scope="row">{y}</th>
                    <td>
                      {official('open', y) && (
                        <>
                          <a href={official('open', y).exam} aria-label={`Open exam ${y}, exam`}>Exam</a>{' '}
                          <a href={official('open', y).key} aria-label={`Open exam ${y}, answer key`}>Key</a>
                        </>
                      )}
                    </td>
                    <td>{cut.open.cutoffs[y] ?? ''}</td>
                    <td>
                      {official('semifinal', y) && (
                        <>
                          <a href={official('semifinal', y).exam} aria-label={`Semifinal exam ${y}, exam`}>Exam</a>{' '}
                          <a href={official('semifinal', y).key} aria-label={`Semifinal exam ${y}, answer key`}>Key</a>
                        </>
                      )}
                    </td>
                    <td>{cut.semifinal.cutoffs[y] ?? ''}</td>
                    <td>{notes(y)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="more">The cutoff scores were collected by the club coordinator. CEE does not publish them in one place.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .resources {
    max-width: 1000px;
  }
  .lede {
    font-size: var(--step-1);
    color: var(--ink-soft);
    margin: 12px 0 0;
  }
  .subject {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: clamp(24px, 5vw, 72px);
    padding-block: 36px;
    margin-top: 40px;
    border-top: 1px solid var(--rule);
  }
  .subject-head p {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: 10px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-block: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .rows li:first-child {
    padding-top: 0;
  }
  .rows h3 {
    font-size: 1.15rem;
  }
  .meta {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin: 4px 0 0;
  }
  .more {
    font-size: var(--step--1);
    color: var(--ink-soft);
    margin-top: 18px;
  }
  .subject-body > p:first-child {
    margin-top: 0;
  }

  .scroll {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-top: 24px;
  }
  caption {
    text-align: left;
    color: var(--ink-soft);
    padding-bottom: 12px;
    max-width: 62ch;
  }
  th,
  td {
    text-align: left;
    padding: 9px 14px 9px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  thead th {
    font: 650 var(--step--1) / 1.3 var(--sans);
    border-bottom: 2px solid var(--ink);
  }
  tbody th {
    font-family: var(--sans);
    font-weight: 600;
  }
  td {
    font-variant-numeric: tabular-nums;
  }
  td:last-child {
    color: var(--ink-soft);
  }
  td:nth-child(2),
  td:nth-child(4) {
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .subject {
      grid-template-columns: 1fr;
    }
    .rows li {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
