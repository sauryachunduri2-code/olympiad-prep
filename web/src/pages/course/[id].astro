---
import Base from '../../layouts/Base.astro';
import CourseArt from '../../components/CourseArt.astro';
import { COURSES, fmaTopics, fmaQuestionCount, usaboQuestionCount, type CourseId } from '../../lib/courses';
import { biologyTopics, loadPapers, loadTaggedPapers, paperTitle } from '../../lib/papers';

export function getStaticPaths() {
  return (['fma', 'usabo', 'usnco'] as CourseId[]).map((id) => ({ params: { id } }));
}

const id = Astro.params.id as CourseId;
const course = COURSES[id];

const topics = id === 'fma' ? fmaTopics() : [];
const exams = loadPapers().filter((p) => p.paper.competition_id === id);

// USABO: how many tagged questions touch each subtopic
const usaboCounts = new Map<string, number>();
if (id === 'usabo') {
  for (const p of loadTaggedPapers().filter((p) => p.paper.competition_id === 'usabo'))
    for (const q of p.questions) for (const t of q.topics) usaboCounts.set(t.slug, (usaboCounts.get(t.slug) ?? 0) + 1);
}
const areas = id === 'usabo' ? biologyTopics().filter((a) => a.subtopics.some((s) => usaboCounts.has(s.slug))) : [];

const examData = JSON.stringify(
  exams.map((p) => ({ id: p.id, limit: p.paper.time_limit_minutes * 60, total: p.questions.length })),
).replace(/</g, '\\u003c');
---

<Base
  title={`${course.name}: Olympiad Prep`}
  current={id}
  crumbs={[{ label: 'Courses' }, { label: course.name }]}
  description={course.summary}
>
  <header class="hero panel" style={`--c:${course.color}`}>
    <div class="art"><CourseArt kind={course.art} /></div>
    <div class="hero-body">
      <span class="kind">{course.discipline}</span>
      <h1>{course.name}</h1>
      <p class="summary">{course.summary}</p>
      {
        id === 'fma' && (
          <div class="facts">
            <span class="pill">{fmaQuestionCount()} questions</span>
            <span class="pill">{topics.length} topics</span>
            <span class="pill">{exams.length} timed exams</span>
          </div>
        )
      }
      {
        id === 'usabo' && (
          <div class="facts">
            <span class="pill">{usaboQuestionCount()} tagged questions</span>
            <span class="pill">Open Exams 2015 to 2018</span>
            <span class="pill">Cutoffs 2004 to 2026</span>
          </div>
        )
      }
      {
        id === 'usnco' && (
          <div class="facts">
            <span class="pill">Local exam: 60 questions, 110 minutes</span>
            <span class="pill">National exam: three parts</span>
          </div>
        )
      }
      <div class="actions">
        {id === 'fma' && <a class="btn" href="#topics">Practice by topic</a>}
        {id === 'fma' && <a class="btn quiet" href="#exams">Sit an exam</a>}
        {id === 'usabo' && <a class="btn" href="/hub/usabo/">Find questions by topic</a>}
        {id === 'usabo' && <a class="btn quiet" href="/hub/#biology">Official exams and cutoffs</a>}
        {id === 'usnco' && <a class="btn" href="https://www.acs.org/education/olympiad/prepare-for-exams.html">Official ACS exams</a>}
      </div>
    </div>
  </header>

  {
    id === 'fma' && (
      <>
        <section class="section" id="topics">
          <h2>Practice by topic</h2>
          <p class="sub">
            Each oval is one question. It turns green when you got it right last time and red with a slash when you missed it.
          </p>
          <div class="cards" style={`--c:${course.color}`}>
            {topics.map((t) => (
              <a class="panel topic" href={`/practice/fma/${t.slug}/`} data-ids={JSON.stringify(t.questions.map((q) => q.id))}>
                <h3>{t.name}</h3>
                <p class="muted count">
                  {t.questions.length} {t.questions.length === 1 ? 'question' : 'questions'}
                </p>
                <div class="dots" aria-hidden="true">
                  {t.questions.map((q) => (
                    <span class="dot" data-id={q.id} />
                  ))}
                </div>
                <div class="track" aria-hidden="true">
                  <i data-bar />
                </div>
                <p class="stat muted" data-stat>
                  Not started
                </p>
              </a>
            ))}
          </div>
        </section>

        <section class="section" id="exams">
          <h2>Exams</h2>
          <p class="sub">Full past papers with the real time limit. Your answers go on a bubble sheet like the one in the exam room.</p>
          <ul class="exam-list panel" style={`--c:${course.color}`}>
            {exams.map((p) => (
              <li data-exam={p.id}>
                <div>
                  <h3>{paperTitle(p)}</h3>
                  <p class="muted meta">
                    {p.questions.length} questions, {p.paper.time_limit_minutes} minutes. <a href={p.paper.source_url}>Official exam</a>{' '}
                    and <a href={p.paper.solutions_url}>solutions</a>.
                  </p>
                  <p class="status" data-status />
                </div>
                <a class="btn" href={`/papers/${p.id}/`} data-sit>
                  Sit exam
                </a>
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  {
    id === 'usabo' && (
      <section class="section">
        <h2>Topics</h2>
        <p class="sub">
          USABO questions belong to CEE, so they are not copied here. Each topic lists the questions that test it, with a link
          to CEE's own exam.
        </p>
        <div class="cards" style={`--c:${course.color}`}>
          {areas.map((a) => (
            <div class="panel area">
              <h3>{a.name}</h3>
              <ul>
                {a.subtopics
                  .filter((s) => usaboCounts.has(s.slug))
                  .map((s) => (
                    <li>
                      <a href={`/hub/usabo/#${s.slug}`}>{s.name}</a>
                      <span class="muted">{usaboCounts.get(s.slug)}</span>
                    </li>
                  ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    id === 'usnco' && (
      <section class="section">
        <div class="panel soon">
          <h2>USNCO practice is not here yet</h2>
          <p>
            The American Chemical Society posts past local and national exams, with answer keys, on its own site. Until they
            can be added here, that is the best place to practice.
          </p>
          <p class="muted">
            The local exam is 60 multiple-choice questions in 110 minutes. The national exam has a 60-question multiple-choice
            part, a written problem-solving part, and a lab practical.
          </p>
          <a class="btn" href="https://www.acs.org/education/olympiad/prepare-for-exams.html">Open the ACS exams page</a>
        </div>
      </section>
    )
  }

  <script type="application/json" id="exam-data" set:html={examData} />
  <script>
    import { attemptFor, examHistory, loadPractice, stateOf, summarize } from '../../scripts/progress';

    const progress = loadPractice();

    document.querySelectorAll<HTMLElement>('.topic').forEach((card) => {
      const ids: string[] = JSON.parse(card.dataset.ids!);
      card.querySelectorAll<HTMLElement>('.dot').forEach((d) => (d.dataset.s = stateOf(progress, d.dataset.id!)));
      const s = summarize(progress, ids);
      (card.querySelector('[data-bar]') as HTMLElement).style.width = `${(s.correct / ids.length) * 100}%`;
      (card.querySelector('[data-stat]') as HTMLElement).textContent =
        s.correct + s.missed === 0 ? 'Not started' : `${s.correct} of ${ids.length} correct${s.missed ? `, ${s.missed} to retry` : ''}`;
    });

    const exams: { id: string; limit: number; total: number }[] = JSON.parse(document.getElementById('exam-data')!.textContent!);
    for (const e of exams) {
      const row = document.querySelector<HTMLElement>(`[data-exam="${e.id}"]`);
      if (!row) continue;
      const status = row.querySelector<HTMLElement>('[data-status]')!;
      const sit = row.querySelector<HTMLAnchorElement>('[data-sit]')!;
      const a = attemptFor(e.id);
      const best = examHistory(e.id).reduce((m, d) => Math.max(m, d.score), -1);
      if (a && !a.submittedAt && a.startedAt + e.limit * 1000 > Date.now()) {
        status.textContent = `In progress, ${Math.floor((a.startedAt + e.limit * 1000 - Date.now()) / 60000)} minutes left`;
        sit.textContent = 'Resume exam';
      } else if (best >= 0) {
        status.textContent = `Best score: ${best} of ${e.total}`;
        sit.textContent = 'Sit again';
      } else {
        status.textContent = 'Not attempted yet';
        status.classList.add('muted');
      }
    }
  </script>
</Base>

<style>
  .hero {
    overflow: hidden;
  }
  .hero .art {
    height: 150px;
    border-bottom: 1px solid var(--line);
  }
  .hero-body {
    padding: 26px clamp(20px, 3vw, 36px) 30px;
  }
  .kind {
    font: 600 0.85rem / 1 var(--sans);
    color: var(--c);
  }
  .hero h1 {
    margin: 8px 0 12px;
  }
  .summary {
    color: var(--muted);
    font-size: var(--step-1);
    max-width: 60ch;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 22px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .topic {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 20px 22px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 140ms ease;
  }
  .topic:hover {
    border-color: var(--c);
  }
  .topic h3 {
    font-size: 1.1rem;
  }
  .topic p {
    margin: 0;
  }
  .count,
  .stat {
    font-size: 0.86rem;
  }

  .exam-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exam-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 24px;
  }
  .exam-list li + li {
    border-top: 1px solid var(--line);
  }
  .exam-list h3 {
    font-size: 1.15rem;
  }
  .meta,
  .status {
    margin: 4px 0 0;
    font-size: 0.9rem;
  }
  .status {
    color: var(--c);
  }

  .area {
    padding: 20px 22px;
  }
  .area h3 {
    margin-bottom: 12px;
    font-size: 1.1rem;
  }
  .area ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .area li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.93rem;
    padding-block: 4px;
    border-bottom: 1px solid var(--line);
  }
  .area li a {
    color: var(--text);
    text-decoration: none;
  }
  .area li a:hover {
    color: var(--c);
  }

  .soon {
    padding: 28px clamp(20px, 3vw, 36px);
    max-width: 760px;
  }
  .soon h2 {
    margin-bottom: 12px;
  }
  .soon .btn {
    margin-top: 6px;
  }

  @media (max-width: 600px) {
    .exam-list li {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
